# Required
ANTHROPIC_API_KEY=sk-ant-...
# At least 32 random characters, e.g. `openssl rand -hex 32`
SESSION_SECRET=change-me-to-a-long-random-string-0123456789

# Optional
AI_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max (low is plenty for classification and extraction)
AI_EFFORT=low
# Comma-separated bundle ids accepted as the audience of Sign in with Apple tokens
APPLE_BUNDLE_IDS=com.example.wardrobe
SESSION_TTL_DAYS=30
# Requests per user per window on the AI endpoints
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=600
# Local development only: accept identityToken "dev" without Apple verification
AUTH_DEV_BYPASS=false
PORT=8787
