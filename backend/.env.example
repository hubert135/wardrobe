# Required: at least 32 random characters, e.g. `openssl rand -hex 32`
SESSION_SECRET=change-me-to-a-long-random-string-0123456789

# AI features. Each one is optional; without a key that feature answers "not set up".
# Claude: garment recognition, order import, outfit ranking
ANTHROPIC_API_KEY=
# OpenAI: store-style product photos (about $0.05 per photo at medium quality)
OPENAI_API_KEY=
IMAGE_MODEL=gpt-image-2
# low | medium | high
IMAGE_QUALITY=medium
# Store photos per user per window (they are the most expensive call)
RENDER_RATE_LIMIT_REQUESTS=30
RENDER_RATE_LIMIT_WINDOW_SECONDS=3600

# Optional
AI_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max (low is plenty for classification and extraction)
AI_EFFORT=low
# Comma-separated bundle ids accepted as the audience of Sign in with Apple tokens
APPLE_BUNDLE_IDS=com.example.wardrobe
SESSION_TTL_DAYS=30
# Requests per user per window on the AI endpoints
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=600
# Local development only: accept identityToken "dev" without Apple verification
AUTH_DEV_BYPASS=false
PORT=8787
